<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above. Same intent as backup_rules.xml, declared explicitly
    for both cloud backup and direct device-to-device transfer rather than
    relying on the platform default.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="cache" />
    </device-transfer>
</data-extraction-rules>
