<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background: the Pentaword gradient, drawn edge to edge so the
    launcher can crop it to any mask shape without revealing a seam.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#7B6EF6"
        android:centerColor="#4F7EF0"
        android:endColor="#10A37B" />
</shape>
